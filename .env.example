# Copy this to .env and fill in your values
# chmod 600 .env  ← important, this file contains secrets

TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_personal_chat_id_here

ANTHROPIC_API_KEY=your_anthropic_api_key_here

DB_HOST=localhost
DB_PORT=3306
DB_NAME=konstip_notetaker
DB_USER=notetaker
DB_PASSWORD=your_db_password_here

# Optional: change summary time (24h format)
SUMMARY_HOUR=8
SUMMARY_MINUTE=0

# Notion integration (optional — leave blank to disable)
# NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Required Notion database properties:
#   Name       (Title)
#   Category   (Select: Work, Home, MCM, YFU, Personal, Other, Unknown)
#   Due Date   (Date)
#   Done       (Checkbox)
#   Done At    (Date)
#   Task ID    (Number)

